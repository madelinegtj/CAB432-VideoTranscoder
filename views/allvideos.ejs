<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Uploaded Videos</title>
    <link 
        rel="stylesheet"
        href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
    />

</head>
<body>
    <div class="videos-container">
        <h1 class="page-title">Your Uploaded Videos</h1>
        <div class="videos-grid" id="videos-grid">
        <!-- Videos will be dynamically inserted here -->
        </div>
    </div>

</body>
<!-- Logic for fetching and rendering the videos -->
<script>
    // Function to fetch video data from the backend
    async function fetchVideos() {
    try {
        const response = await fetch('/json/video');    // Fetch the route that return JSON response
        const videos = await response.json();

        // Grab the video grid container
        const videoGrid = document.getElementById('videos-grid');

        // Clear any existing content
        videoGrid.innerHTML = '';

        // Default if there is no video to display
        if (videos.length === 0) {
            const noVideosCard = document.createElement('div');
            noVideosCard.classList.add('empty-card'); // Use the same class as video cards
            noVideosCard.innerHTML = `
                <p class="no-videos-message">No videos uploaded.</p>
            `;
            videoGrid.appendChild(noVideosCard);
        }

        // Iterate over the videos and render each one
        videos.forEach(video => {
            const videoCard = document.createElement('div');
            videoCard.classList.add('video-card');
            videoCard.id = `video-${video.id}`; // Assign a unique ID to the video card

            // Round the duration to 2 decimal places
            const roundedDuration = parseFloat(video.duration).toFixed(2);

            videoCard.innerHTML = `
                <h3 class="video-title">${video.title}</h3>
                <video class="video-player" controls>
                    <source src="/public${video.filepath}" type="${video.mimetype}" />
                    Your browser does not support the video tag.
                </video>
                <p class="video-duration">Duration: ${roundedDuration} seconds</p>
                <button class="delete-button" onclick="deleteVideo(${video.id})">Delete Video</button>
            `;

            // Append the video card to the grid
            videoGrid.appendChild(videoCard);
        });
    } catch (error) {
        console.error('Error fetching videos:', error);
    }
    }

    // Call the function when the page loads
    fetchVideos();

    // Function to delete the selected video
    async function deleteVideo(videoId) {
        const confirmation = confirm("Are you sure you want to delete this video?");
        if (!confirmation) {
            return; // Exit if user cancels
        }

        try {
            const response = await fetch(`/delete/${videoId}`, {
                method: 'DELETE',
            });

            if (response.ok) {
                const message = await response.json();
                alert(message.message); // Show success message

                // Check if the Video Card element still exists 
                const videoElement = document.getElementById(`video-${videoId}`);
                if (videoElement) {
                    videoElement.remove();   // Remove video card from the DOM
                }else {
                    console.warn(`Element with ID video-${videoId} not found`);
                }
                
            } else {
                const errorMessage = await response.json();
                alert(errorMessage.message); // Show error message
            }
        } catch (error) {
            console.error('Error deleting video:', error);
            alert('An error occurred while trying to delete the video.');
        }
    }
</script>
<style>
    body {
        font-family: Arial, sans-serif;
        background-color: #01346b;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }
    .videos-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .page-title {
        text-align: center;
        color: #ffffff;
        margin-bottom: 40px;
    }

    /* Grid container for the video cards */
    .videos-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        justify-content: space-around;
    }

    /* Individual video card styling */
    .video-card {
        border: 2px solid #ddd;
        border-radius: 8px;
        padding: 10px;
        width: 320px;
        background-color: #f9f9f9;
        text-align: center;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
    }

    .empty-card {
        border: 2px solid #ddd;
        display: flex;
        border-radius: 8px;
        padding: 10px;
        width: 600px;
        min-height: 240px;
        background-color: #f9f9f9;
        text-align: center;
        justify-content: center;
        align-items: center;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
    }

    .video-title {
        font-size: 1.15rem;
        margin-bottom: 10px;
        color: #444;
    }

    .video-duration {
        font-size: 0.9rem;
        color: #666;
    }

    .video-player {
        width: 100%;       /* Ensure the video takes the full width of the card */
        height: auto;      /* Maintain aspect ratio */
        max-height: 240px;
    }
</style>
</html>
