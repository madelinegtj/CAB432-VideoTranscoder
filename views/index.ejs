<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Video Converter App</title>
    <link 
        rel="stylesheet"
        href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
    /> <%# Contain predefined styles; determined by div class %>
</head>
<body>
    <div class="container">
        <br/>
        <h1 class="text-center" style="margin-top:20px;">
            Online Video Converter
        </h1>
        <br/>
        <form id="form" enctype="multipart/form-data">
            <div class="form-group">
                <label for="video">Select Video:</label>
                <input 
                    class="form-control"
                    type="file" 
                    name="files" 
                    id="upload-input" 
                    accept="video/" 
                    required/>
            </div>
            <div id="progressContainer" style="display:none;">
                <progress id="uploadProgress" role="progressbar" value="0" max="100" style="width: 100%;"></progress>
                <span id="progressText" style="align-self:right;">0%</span>
            </div>
            <div class="form-group">
                <label for="format">Select Format:</label>
                <select class="form-control" id="format">
                    <option value="mp4" selected>mp4</option>
                    <option value="avi">avi</option>
                    <option value="flv">flv</option>
                    <option value="gif">gif</option>
                    <option value="m4v">m4v</option>
                    <option value="mov">mov</option>
                </select>
            </div>
            <div class="form-group">
                <button id="button" class="button" type="submit">
                    Upload & Convert
                </button>
            </div>
            <div id="metadata-section">
                <label>Video Metadata:</label>
                <ul id="metadata-list" 
                    style="list-style-type:none; padding-left:0; font-size:11px;"
                ></ul> <!-- This will be dynamically populated with metadata -->
            </div>
            <div class="form-group">
                <button id="download-button" class="button">
                    Download Video File
                </button>
            </div>
        </form>
        <a href="/video">See All Uploaded Videos</a>
        <br/>
    </div>
</body>
<script src="https://cdn.jsdelivr.net/npm/browser-image-converter@0.1.1/dist/index.min.js"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
<script>
    // <----- Event Listener when the form is submitted ----->
    let convertData; 

    $("#metadata-section").hide();
    $("#download-button").hide();

    document.getElementById('form').addEventListener('submit', async (event) => {
        event.preventDefault();
        
        const formData = new FormData(event.target);
        
        // Show progress bar
        const progressContainer = document.getElementById('progressContainer');
        const progressBar = document.getElementById('uploadProgress');
        const progressText = document.getElementById('progressText');
        progressContainer.style.display = 'block';

        // -- UPLOAD VIDEO --
        // Use XMLHttpRequest for tracking upload progress
        const xhr = new XMLHttpRequest();

        // Update progress bar during upload
        xhr.upload.addEventListener('progress', (e) => {
            if (e.lengthComputable) {
                const percentComplete = (e.loaded / e.total) * 100;
                progressBar.value = percentComplete;
                progressText.textContent = `${Math.round(percentComplete)}%`;
            }
        });

        // Open the request and send the form data
        xhr.open('POST', '/uploadvideo', true);

        // Handle success/failure
        xhr.onload = function () {
            const result = JSON.parse(xhr.responseText);
            console.log("Upload Response:", result);
            alert(result.message || 'Upload failed!');

            // If successful
            if(xhr.status === 200){
                // prepare the data for conversion
                convertData = {
                    format: $("#format").val(), 
                    codec: 'h264', 
                    videoData: {
                        filepath: result.metadata.filepath,
                        mimetype: result.metadata.mimetype, 
                        filename: result.metadata.filename,
                        codec: result.metadata.codec 
                    }
                };
                
                // -- CONVERT VIDEO --
                // Send the request to convert the video
                const convertXhr = new XMLHttpRequest();
                convertXhr.open('POST', '/convertvideo', true);
                convertXhr.setRequestHeader('Content-Type', 'application/json'); // Set appropriate header
                convertXhr.send(JSON.stringify(convertData)); // Send the convert data as JSON

                $("#button").hide();
                $("#download-button").show();

                // Reset progress bar
                progressBar.value = 0;
                progressText.textContent = '0%';
                progressContainer.style.display = 'none';

                // Check if metadata is available and call displayMetadata function
                if (result.metadata) {
                    displayMetadata(result.metadata); // Call the function to display metadata
                }

                // -- DOWNLOAD VIDEO --
                //const downloadXhr = new XMLHttpRequest();
                //downloadXhr.open('POST', '/convertvideo', true);
                //downloadXhr.setRequestHeader('Content-Type', 'application/json'); // Set appropriate header
                //downloadXhr.send(JSON.stringify(convertData)); // Send the convert data as JSON
            }

            

        };

        // Handle error
        xhr.onerror = function () {
            alert('Upload failed! Please try again.');
            progressBar.value = 0;
            progressText.textContent = '0%';
            progressContainer.style.display = 'none';
        };

        // Send the form data for the upload
        xhr.send(formData);
        console.log("formData sent");
    });

    document.getElementById('download-button').addEventListener('click', function(event) {
        event.preventDefault();  
        // Make a POST request to /downloadvideo
        const xhr = new XMLHttpRequest();
        xhr.open('POST', '/downloadvideo', true);
        xhr.responseType = 'blob'; // Expecting a blob response (the video file)
        xhr.onload = function () {
            if (xhr.status === 200) {
                // Create a link element to download the file
                const blob = xhr.response;
                const downloadUrl = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = downloadUrl;
                a.download = convertData.videoData.filename.split(".")[0] + "." + convertData.format;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                window.URL.revokeObjectURL(downloadUrl); // Clean up the URL object

                // Reset the form after the video has been downloaded
                document.getElementById('form').reset();
                $("#metadata-section").hide();
                $("#download-button").hide();
                $("#button").show();
            } else {
                console.error('Failed to download video:', xhr.statusText);
                alert('Failed to download video');
            }
        };
        xhr.onerror = function () {
            console.error('Error during the download request');
            alert('Error during the download');
        };

        xhr.send();  // No need to send data since the server already knows the file
    });

    function displayMetadata(metadata) {
        // Select the metadata list in the HTML
        var metadataList = $("#metadata-list");
        metadataList.empty(); // Clear any previous metadata

        // Check if metadata has streams (video information)
        if (metadata) {
            $("#metadata-section").show();  // Show when metadata is available
            
            //metadataList.append("<li><strong>Title:</strong> " + metadata.title + "</li>");
            metadataList.append("<li><strong>Filename:</strong> " + metadata.filename.split(".")[0] + "." + $("#format").val() + "</li>");
            metadataList.append("<li><strong>Filepath:</strong> " + metadata.filepath.split(".")[0] + "." + $("#format").val() + "</li>");
            //metadataList.append("<li><strong>MIME Type:</strong> " + metadata.mimetype + "</li>");
            metadataList.append("<li><strong>Size:</strong> " + (metadata.size / (1024 * 1024)).toFixed(2) + " MB</li>");
            metadataList.append("<li><strong>Duration:</strong> " + Math.round(metadata.duration) + " seconds</li>");
            //metadataList.append("<li><strong>Author:</strong> " + metadata.author + "</li>");
            metadataList.append("<li><strong>Codec:</strong> " + metadata.codec + "</li>");
            // add thumbnail
            if (metadata.thumbnail) {
                metadataList.append("<img src='" + metadata.thumbnail + "' alt='Thumbnail' width='426' height='240'/></li> ");
            }

        } else {
            metadataList.append("<li>No video metadata found</li>");
        }
    }
    
