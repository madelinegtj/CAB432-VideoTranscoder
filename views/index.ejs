<style>
    body {
        font-family: Arial, sans-serif;
        background-color: #01346b;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

    .container {
        display: flex;
        flex-direction: column;
        align-items: center;
        background-color: #fff;
        width: 600px;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 5px 10px rgba(0, 0, 0, 0.1);
        margin: 20px;
        margin-top: 10px;
    }

    .form {
        display: flex;
        flex-direction: row;
        width: 500px;
        margin-bottom: 10px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    .form label {
        display: block;
        margin-bottom: 5px;
    }

    .button {
        width: 100%;
        padding: 10px;
        background-color: #007bff;
        color: #fff;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    .button:hover {
        background-color: #0056b3;
    }

    #metadata-section {
        margin-top: 20px;
    }

    #metadata-list li {
        margin: 2px 0;
    }
</style>
</html>

